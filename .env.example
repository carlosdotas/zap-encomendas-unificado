# Exemplo de configuração - não publique senhas reais
PORT=3000
HOST=0.0.0.0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nome_do_banco
DB_USER=usuario_mysql
DB_PASSWORD=senha_mysql

# Google Places API (New) - chave de servidor; configurar na hospedagem
# Ative Places API (New) no Google Cloud e restrinja a chave a essa API.
GOOGLE_MAPS_API_KEY=

# Chave PUBLICA de navegador para Maps JavaScript API (restringir por HTTP referrers)
# Diferente da chave privada GOOGLE_MAPS_API_KEY usada em Places API (New).
GOOGLE_MAPS_BROWSER_KEY=

# Criacao inicial do PRIMEIRO administrador no MySQL (nao e senha mestre).
# Configure na hospedagem, nao no repositorio. Senha forte de no minimo 12 caracteres.
# So cria a conta quando ainda nao existe nenhum administrador.
# Depois da primeira criacao, remova ADMIN_PASSWORD das variaveis da hospedagem.
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Recuperacao EXPLICITA da senha de um administrador existente.
# Ative TEMPORARIAMENTE junto com ADMIN_PHONE e ADMIN_PASSWORD.
# Nao cria administrador, nao promove usuario comum.
# Remova esta flag e ADMIN_PASSWORD apos o primeiro reinicio bem-sucedido.
ADMIN_RESET_PASSWORD=false

# Push Android opcional: configure no servidor, nunca dentro do APK.
FIREBASE_PROJECT_ID=
# Caminho privado para a credencial de servico Firebase, fora do repositorio.
GOOGLE_APPLICATION_CREDENTIALS=
