<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides the actual Capacitor layout; activity_main.xml is not used by BridgeActivity. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/zap_webview_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="@color/zap_system_bar_surface">
    <com.getcapacitor.CapacitorWebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false" />
</FrameLayout>
