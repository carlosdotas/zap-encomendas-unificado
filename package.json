{
  "name": "zap-encomendas-unificado",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor Node.js e MySQL da Zap Encomendas",
  "main": "api/index.js",
  "scripts": {
    "start": "node server.js",
    "android:sync": "node scripts/sync-mobile.js",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "test:mobile": "node --test test/*.test.js",
    "android:release": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:icons": "node scripts/generate-icons.js",
    "android:test:prepare": "node scripts/prepare-ime-tests.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "firebase-admin": "^13.10.0",
    "mysql2": "^3.15.0",
    "ws": "^8.18.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
