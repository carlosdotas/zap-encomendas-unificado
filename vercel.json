{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/auth/[action].js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "navigation.js",
      "use": "@vercel/static"
    },
    {
      "src": "location-input.js",
      "use": "@vercel/static"
    },
    {
      "src": "shared-location.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/api/auth/([^/]+)$",
      "dest": "/api/auth/[action].js?action=$1"
    },
    {
      "src": "^/health$",
      "dest": "/api/index.js?health=1"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
